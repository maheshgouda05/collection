# ==============================================================================
# Collection It All (Ward Room) - Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI Stylist calls.
# In AI Studio, this is injected from user secrets.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The host URL for this application.
APP_URL="http://localhost:3000"

# SUPABASE_URL: The REST API URL for your Supabase project (e.g. https://xyz.supabase.co)
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Client-safe anonymous API key.
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret key for administrative tasks (bypass RLS when required).
# NEVER expose this key to browser bundles.
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# WEATHER_API_PROVIDER: Provider to use ('open-meteo' [free, no key required], 'weatherapi', 'openweathermap')
WEATHER_API_PROVIDER="open-meteo"

# WEATHER_API_KEY: Optional API key if using WeatherAPI or OpenWeatherMap
WEATHER_API_KEY=""

# STORAGE_BUCKET: The Supabase Storage bucket for wardrobe garment photos
SUPABASE_STORAGE_BUCKET="wardrobe-images"
